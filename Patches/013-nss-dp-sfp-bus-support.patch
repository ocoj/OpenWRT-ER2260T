+#if IS_ENABLED(CONFIG_SFP)
+static void nss_dp_sfp_attach(void *upstream, struct sfp_bus *bus)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	dp_priv->netdev->sfp_bus = bus;
+}
+
+static void nss_dp_sfp_detach(void *upstream, struct sfp_bus *bus)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	dp_priv->netdev->sfp_bus = NULL;
+}
+
+static int nss_dp_sfp_module_insert(void *upstream,
+				    const struct sfp_eeprom_id *id)
+{
+	return 0;
+}
+
+static void nss_dp_sfp_module_remove(void *upstream)
+{
+}
+
+static int nss_dp_sfp_module_start(void *upstream)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	if (dp_priv->phydev)
+		phy_start(dp_priv->phydev);
+
+	return 0;
+}
+
+static void nss_dp_sfp_module_stop(void *upstream)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	if (dp_priv->phydev)
+		phy_stop(dp_priv->phydev);
+}
+
+static void nss_dp_sfp_link_down(void *upstream)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	netif_carrier_off(dp_priv->netdev);
+}
+
+static void nss_dp_sfp_link_up(void *upstream)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	netif_carrier_on(dp_priv->netdev);
+}
+
+static int nss_dp_sfp_connect_phy(void *upstream, struct phy_device *phy)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+	int ret;
+
+	if (dp_priv->phydev)
+		return -EBUSY;
+
+	ret = phy_connect_direct(dp_priv->netdev, phy,
+				 nss_dp_adjust_link,
+				 dp_priv->phy_mii_type);
+	if (ret)
+		return ret;
+
+	dp_priv->phydev = phy;
+	phy_attached_info(phy);
+
+	return 0;
+}
+
+static void nss_dp_sfp_disconnect_phy(void *upstream,
+				      struct phy_device *phydev)
+{
+	struct nss_dp_dev *dp_priv = upstream;
+
+	if (dp_priv->phydev) {
+		phy_disconnect(dp_priv->phydev);
+		dp_priv->phydev = NULL;
+	}
+}
+
+static const struct sfp_upstream_ops nss_dp_sfp_upstream_ops = {
+	.attach = nss_dp_sfp_attach,
+	.detach = nss_dp_sfp_detach,
+	.module_insert = nss_dp_sfp_module_insert,
+	.module_remove = nss_dp_sfp_module_remove,
+	.module_start = nss_dp_sfp_module_start,
+	.module_stop = nss_dp_sfp_module_stop,
+	.link_down = nss_dp_sfp_link_down,
+	.link_up = nss_dp_sfp_link_up,
+	.connect_phy = nss_dp_sfp_connect_phy,
+	.disconnect_phy = nss_dp_sfp_disconnect_phy,
+};
+#endif
+
