+
+/dts-v1/;
+#include "ipq807x-soc.dtsi"
+#include <dt-bindings/qcom/gpio-ipq807x.h>
+/ {
+	machid = <0x08010006>;
+	config_name = "config@hk07", "config-hk07";
+
+	aliases {
+		console = "/serial@78B3000";
+		uart2 = "/serial@78B0000";
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			gpio = <50>;
+			func = <0>;
+			drvstr = <GPIO_8MA>;
+			pull = <GPIO_PULL_UP>;
+			oe = <GPIO_OE_DISABLE>;
+			active_level = <GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_sys {
+			label = "blink_led", "power_led", "system_led";
+			gpio = <21>;
+			func = <0>;
+			out = <GPIO_OUT_LOW>;
+			drvstr = <GPIO_8MA>;
+			pull = <GPIO_PULL_DOWN>;
+			oe = <GPIO_OE_ENABLE>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+
+		led_usb {
+			label = "green:usb";
+			gpio = <22>;
+			func = <0>;
+			out = <GPIO_OUT_LOW>;
+			drvstr = <GPIO_8MA>;
+			pull = <GPIO_PULL_DOWN>;
+			oe = <GPIO_OE_ENABLE>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+
+		led_sfp1 {
+			label = "green:sfp1";
+			gpio = <51>;
+			func = <0>;
+			out = <GPIO_OUT_LOW>;
+			drvstr = <GPIO_8MA>;
+			pull = <GPIO_PULL_DOWN>;
+			oe = <GPIO_OE_ENABLE>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+
+		led_sfp2 {
+			label = "green:sfp2";
+			gpio = <55>;
+			func = <0>;
+			out = <GPIO_OUT_LOW>;
+			drvstr = <GPIO_8MA>;
+			pull = <GPIO_PULL_DOWN>;
+			oe = <GPIO_OE_ENABLE>;
+			active_level = <GPIO_ACTIVE_HIGH>;
+		};
+	};
+
+	ess-switch {
+		switch_mac_mode = <0x0>;
+		switch_mac_mode1 = <0x7>;
+		switch_mac_mode2 = <0x7>;
+		sfp_port1 = <4>;
+		sfp_port2 = <5>;
+		sfp_gpio = <59>;
+		napa_gpio = <37>;
+		napa_gpio_cnt = <1>;
+		uniphy_ext_ref_clk;
+		port_phyinfo {
+			port@0 {
+				phy_address = <0>;
+				phy_type = <1>;
+			};
+			port@1 {
+				phy_address = <1>;
+				phy_type = <1>;
+			};
+			port@2 {
+				phy_address = <2>;
+				phy_type = <1>;
+			};
+			port@3 {
+				phy_address = <3>;
+				phy_type = <1>;
+			};
+			port@4 {
+				phy_address = <29>;
+				phy_type = <5>;
+			};
+			port@5 {
+				phy_address = <30>;
+				phy_type = <5>;
+			};
+		};
+	};
+};
